---
import { Image } from 'astro:assets';
import { portfolio, projects, news, education, experience, research, publications, awards, qualifications } from '../data/portfolio';
import HistorySection from '../components/HistorySection.astro';
import ResearchSection from '../components/ResearchSection.astro';
import PublicationsSection from '../components/PublicationsSection.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const pageTitle = `${portfolio.name} | Portfolio`;
const canonical = new URL(`${base}/`, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={portfolio.introduction} />
    <meta name="theme-color" content="#fcfcfc" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={portfolio.introduction} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical.href} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="wrap">
      <nav class="navigation" aria-label="メインナビゲーション">
        <a href="#about">自己紹介</a>
        {education.length > 0 && <a href="#education">経歴</a>}
        {research.length > 0 && <a href="#research">研究</a>}
        {projects.length > 0 && <a href="#projects">制作物</a>}
        {publications.length > 0 && <a href="#publications">論文歴</a>}
        {(awards.length > 0 || qualifications.length > 0) && <a href="#awards">受賞・資格</a>}
        {portfolio.cvPath && <a href={asset(portfolio.cvPath)}>CV (PDF)</a>}
      </nav>
      <header class="profile-header">
        {portfolio.profileImage ? (
          <img class="profile-image" src={asset(portfolio.profileImage)} alt={`${portfolio.name}のプロフィール写真`} width="150" height="150" />
        ) : (
          <div class="profile-placeholder" aria-hidden="true">{portfolio.name.slice(0, 1).toUpperCase()}</div>
        )}
        <h1>{portfolio.name}{portfolio.englishName && <span class="english-name"> ({portfolio.englishName})</span>}</h1>
        <p class="affiliation">{portfolio.affiliation.map(line => <span>{line}</span>)}</p>
        <div class="social-links">
          <a href={portfolio.githubUrl}>GitHub</a>
          {portfolio.email && <a href={`mailto:${portfolio.email}`} title="メールアプリで送信">Email</a>}
          {portfolio.cvPath && <a href={asset(portfolio.cvPath)}>CV (PDF)</a>}
        </div>
      </header>
      <main id="main">
        <section id="about" aria-labelledby="about-title">
          <h2 id="about-title">自己紹介</h2>
          <p>{portfolio.introduction}</p>
          {portfolio.about.map(text => <p>{text}</p>)}
          {portfolio.interests.length > 0 && <p><strong>興味・専門分野：</strong>{portfolio.interests.join('、')}</p>}
          {portfolio.cvPath && <a class="cv-link" href={asset(portfolio.cvPath)}>CV (PDF) を表示</a>}
        </section>
        <HistorySection id="news" title="お知らせ" entries={news} />
        <HistorySection id="education" title="学歴" entries={education} />
        <HistorySection id="experience" title="職務経験" entries={experience} />
        <ResearchSection />
        {projects.length > 0 && <section id="projects" aria-labelledby="projects-title">
          <h2 id="projects-title">制作物・プロジェクト</h2>
          <div class="projects">
            {projects.map(project => (
              <article id={project.id} class:list={['project', { 'has-image': project.image }]}>
                {project.image && <img class="project-image" src={asset(project.image)} alt={project.imageAlt ?? project.title} loading="lazy" width="800" height="500" />}
                <div class="project-content">
                  <div class="project-meta">
                    {project.date && <span>{project.date}</span>}
                    <span>{project.category}</span>
                    {project.result && <strong>{project.result}</strong>}
                  </div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <dl class="project-details">
                    {project.role && <div><dt>担当</dt><dd>{project.role}</dd></div>}
                    {project.highlight && <div><dt>工夫した点</dt><dd>{project.highlight}</dd></div>}
                    {project.technologies.length > 0 && <div><dt>使用技術</dt><dd>{project.technologies.join(' / ')}</dd></div>}
                  </dl>
                  {project.images && <div class="project-gallery">
                    {project.images.map(cover => <figure>
                      <Image src={cover.src} alt={cover.alt} width={240} widths={[240, 480]} sizes="(max-width: 600px) 40vw, 240px" format="webp" loading="lazy" />
                      <figcaption>{cover.caption}</figcaption>
                    </figure>)}
                  </div>}
                  {(project.demoUrl || project.sourceUrl || project.competitionUrl || project.eventUrl) && <div class="project-links">
                    {project.demoUrl && <a href={project.demoUrl}>{project.demoLabel ?? 'デモを見る'} ↗</a>}
                    {project.sourceUrl && <a href={project.sourceUrl}>GitHub{project.sourcePrivate && '（現在は非公開）'} ↗</a>}
                    {project.competitionUrl && <a href={project.competitionUrl}>大会公式サイト ↗</a>}
                    {project.eventUrl && <a href={project.eventUrl}>学園祭イベント一覧（サークル公式） ↗</a>}
                  </div>}
                </div>
              </article>
            ))}
          </div>
        </section>}
        <PublicationsSection />
        {(awards.length > 0 || qualifications.length > 0) && <section id="awards" aria-labelledby="awards-title">
          <h2 id="awards-title">受賞・資格</h2>
          <HistorySection id="award-list" title="受賞" entries={awards} headingLevel="h3" />
          <HistorySection id="qualifications" title="資格・語学" entries={qualifications} headingLevel="h3" />
        </section>}
      </main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {portfolio.name}</span><a href="#main">ページ上部へ ↑</a></footer>
    </div>
  </body>
</html>
