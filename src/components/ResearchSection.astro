---
import { research } from '../data/portfolio';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{research.length > 0 && <section id="research" aria-labelledby="research-title">
  <h2 id="research-title">研究</h2>
  <div class="research-grid">
    {research.map(item => <article class="research-card">
      {item.image && <img src={`${base}/${item.image.replace(/^\//, '')}`} alt={item.imageAlt ?? item.title} loading="lazy" width="800" height="500" />}
      <div class="research-body">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <p class="research-conference"><span>{item.conference.status}</span>：<a href={item.conference.url}>{item.conference.name} ↗</a></p>
        <div class="research-links">
          {item.repositoryUrl && <a href={item.repositoryUrl}>GitHub{item.repositoryPrivate && '（現在は非公開）'} ↗</a>}
        </div>
      </div>
    </article>)}
  </div>
</section>}
